# --- Large biological data: never commit ---
# Genomes, reads, alignments, indexes, blast DBs
*.fa
*.fasta
*.fna
*.faa
*.fastq
*.fq
*.fq.gz
*.fastq.gz
*.fa.gz
*.fasta.gz
*.gz
*.bam
*.sam
*.cram
*.bai
*.vcf
*.vcf.gz
*.bed.gz
*.2bit
*.nhr
*.nin
*.nsq
*.ndb
*.not
*.ntf
*.nto
*.njs
*.mmi

# BLAST / minimap / bowtie / bwa index shards
*.[0-9].bt2
*.rev.*.bt2
*.amb
*.ann
*.pac

# RepeatModeler working-directory output (run externally — see docs/plan.md
# Stage 2). Only the final <db>-families.fa is a pipeline input, and it's
# already caught by *.fa above; everything else here is bulky intermediate
# junk (Stockholm alignments, cd-hit clusters, BuildDatabase index shards).
*.stk
*.clstr
*.translation
*.nnd
*.nni
*.nog

# Data & results directories: run outputs, not code. Tracked via .gitkeep only.
data/raw/*
data/reference/*
data/interim/*
results/**/*
!data/**/.gitkeep
!results/**/.gitkeep
!data/**/*.md
!data/**/manifest*

# --- Environments / tooling ---
.snakemake/
.nextflow/
work/
*.log
env/*/
!env/*.yml
!env/*.yaml

# --- Editor / OS ---
.DS_Store
Thumbs.db
.vscode/
.idea/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Claude Code local settings
.claude/settings.local.json
